<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="634.0" prefWidth="1000.0" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.icet.controller.DashboardController">
   <children>
      <Pane layoutX="20" layoutY="20" prefHeight="594" prefWidth="960" styleClass="glass-pane">
         <children>
            <!-- Navigation Sidebar -->
            <Pane layoutX="10" layoutY="10" prefHeight="574" prefWidth="238" styleClass="form-container">
               <children>
                  <Label layoutX="44.0" layoutY="43.0" prefHeight="77.0" prefWidth="151.0" styleClass="title-label" text="Pharmaczy" textFill="WHITE">
                     <font>
                        <Font name="System Bold Italic" size="12.0" />
                     </font></Label>
                  <Button layoutX="6.0" layoutY="183.0" mnemonicParsing="false" onAction="#btnDashboardOnAction" prefHeight="34.0" prefWidth="223.0" styleClass="form-button" text="Dashboard" />
                  <Button layoutX="6.0" layoutY="229.0" mnemonicParsing="false" onAction="#btnMedicineOnAction" prefHeight="34.0" prefWidth="223.0" styleClass="form-button" text="Medicine" />
                  <Button layoutX="6.0" layoutY="274.0" mnemonicParsing="false" onAction="#btnSupplierOnAction" prefHeight="34.0" prefWidth="223.0" styleClass="form-button" text="Supplier" />
                  <Button layoutX="7.0" layoutY="321.0" mnemonicParsing="false" onAction="#btnInventoryOnAction" prefHeight="34.0" prefWidth="223.0" styleClass="form-button" text="Inventory" />
                  <Button layoutX="7.0" layoutY="369.0" mnemonicParsing="false" onAction="#btnSalesBillingOnAction" prefHeight="34.0" prefWidth="223.0" styleClass="form-button" text="Sales &amp; Billing" />
                  <Button layoutX="7.0" layoutY="417.0" mnemonicParsing="false" onAction="#btnSaleDetailsOnAction" prefHeight="34.0" prefWidth="223.0" styleClass="form-button" text="Sale Details" />
               </children>
            </Pane>
            <!-- End Navigation Sidebar -->

            <Pane layoutX="280" layoutY="54" prefHeight="100" prefWidth="200" styleClass="form-container">
                <children>
                    <Label layoutX="50" layoutY="20" text="Total Customers" textFill="WHITE" />
                    <Label fx:id="txtTotalCustomers" layoutX="85" layoutY="50" text="100" textFill="WHITE" />
                </children>
            </Pane>
            <Pane layoutX="500" layoutY="54" prefHeight="100" prefWidth="200" styleClass="form-container">
                <children>
                    <Label layoutX="50" layoutY="20" text="Total Orders/Sales" textFill="WHITE" />
                    <Label fx:id="txtAllCustomers" layoutX="85" layoutY="50" text="48" textFill="WHITE" />
                </children>
            </Pane>
            <Pane layoutX="720" layoutY="54" prefHeight="100" prefWidth="200" styleClass="form-container">
                <children>
                    <Label layoutX="40" layoutY="20" text="Total Medicine Stock" textFill="WHITE" />
                    <Label fx:id="txtAllMedicines" layoutX="85" layoutY="50" text="420" textFill="WHITE" />
                </children>
            </Pane>

            <LineChart fx:id="chartMonthlySales" layoutX="264.0" layoutY="187.0" prefHeight="186.0" prefWidth="668.0">
              <xAxis>
                <CategoryAxis prefHeight="5.0" prefWidth="607.0" side="BOTTOM" />
              </xAxis>
              <yAxis>
                <NumberAxis side="LEFT" />
              </yAxis>
            </LineChart>
            <TableView fx:id="tblExpProducts" layoutX="303.0" layoutY="440.0" prefHeight="130.0" prefWidth="271.0">
              <columns>
                <TableColumn fx:id="colDragName" prefWidth="82.0" text="Drug Name" />
                <TableColumn fx:id="colStatus" prefWidth="84.0" text="Status" />
                  <TableColumn fx:id="colExpDate" prefWidth="104.0" text="Expiry Date" />
              </columns>
            </TableView>
            <TableView fx:id="tblLowStock" layoutX="661.0" layoutY="440.0" prefHeight="130.0" prefWidth="271.0">
               <columns>
                  <TableColumn fx:id="colProductDrugName" prefWidth="75.0" text="Drug Name" />
                  <TableColumn fx:id="txtQuantuty" prefWidth="86.0" text="Quantity" />
                  <TableColumn fx:id="txtStockDate" prefWidth="109.0" text="Stock Date" />
               </columns>
            </TableView>
            <Label layoutX="562.0" layoutY="369.0" text="Monthly Sales" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="18.0" />
               </font>
            </Label>
            <Label layoutX="303.0" layoutY="411.0" style="-fx-background-color: red;" text="Expiring Products" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Label>
            <Label layoutX="664.0" layoutY="411.0" style="-fx-background-color: #c4b937;" text="Products Low Stock" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Label>
         </children>
      </Pane>
   </children>
</AnchorPane>
