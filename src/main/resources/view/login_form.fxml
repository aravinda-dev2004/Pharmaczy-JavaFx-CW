<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.icet.controller.LoginController">
   <children>
      <Pane layoutX="50" layoutY="50" prefHeight="500" prefWidth="700" styleClass="glass-pane">
         <children>

            <Label layoutX="230.0" layoutY="150.0" text="Username" textFill="WHITE" />
            <TextField fx:id="txtUsername" layoutX="230.0" layoutY="170.0" prefHeight="34.0" prefWidth="266.0" promptText="Enter Your Username" styleClass="text-field" />

            <Label layoutX="230.0" layoutY="220.0" text="Password" textFill="WHITE" />
            <PasswordField fx:id="txtPassword" layoutX="230.0" layoutY="240.0" prefHeight="34.0" prefWidth="266.0" promptText="Enter Your Password" styleClass="text-field" />

            <Button layoutX="270.0" layoutY="320.0" mnemonicParsing="false" onAction="#btnLoginOnAction" prefHeight="50" prefWidth="186.0" styleClass="form-button" text="Login" />
            <Label layoutX="240.0" layoutY="30.0" prefHeight="97.0" prefWidth="247.0" text="Pharmaczy" textFill="WHITE">
               <font>
                  <Font name="System Bold Italic" size="44.0" />
               </font>
            </Label>
         </children>
      </Pane>
   </children>
</AnchorPane>
