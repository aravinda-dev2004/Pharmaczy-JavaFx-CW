                  <Button layoutX="7.0" layoutY="417.0" mnemonicParsing="false" onAction="#btnSaleDetailsOnAction" prefHeight="34.0" prefWidth="223.0" styleClass="form-button" text="Sale Details" />
               </children>
            </Pane>
            <!-- End Navigation Sidebar -->

            <Label layoutX="572.0" layoutY="58.0" prefHeight="53.0" prefWidth="117.0" text="Inventory">
               <font>
                  <Font name="System Bold" size="25.0" />
               </font>
            </Label>
            <TextField fx:id="txtStockID" layoutX="391.0" layoutY="130.0" promptText="Stock ID" styleClass="text-field" />
            <TextField fx:id="txtSupplierID" layoutX="710.0" layoutY="130.0" promptText="Supplier ID" styleClass="text-field" />
            <DatePicker fx:id="txtStockDateExp" layoutX="549.0" layoutY="162.0" prefHeight="25.0" prefWidth="150.0" promptText="Expiry Date" styleClass="text-field" />
            <TextField fx:id="txtSellingPrice" layoutX="710.0" layoutY="198.0" promptText="Selling Price" styleClass="text-field" />
            <TableView fx:id="tblInventory" layoutX="256.0" layoutY="296.0" prefHeight="280.0" prefWidth="700.0">
               <columns>
                  <TableColumn fx:id="colStockID" prefWidth="56.0" text="Stock ID" />
                  <TableColumn fx:id="colMedicineID" prefWidth="77.0" text="Medicine ID" />
                  <TableColumn fx:id="colSupplierId" prefWidth="69.0" text="Supplier ID" />
                  <TableColumn fx:id="colBatchNumber" prefWidth="103.0" text="Batch Number" />
                  <TableColumn fx:id="colExpDate" prefWidth="88.0" text="Exp.Date" />
                  <TableColumn fx:id="colManDate" prefWidth="91.0" text="Manu.Date" />
                  <TableColumn fx:id="colQtyOnHand" prefWidth="79.0" text="Qty In Stock" />
                  <TableColumn fx:id="colCostPrice" minWidth="0.0" prefWidth="76.0" text="Cost Price" />
                  <TableColumn fx:id="colSellingPrice" prefWidth="117.0" text="Selling Price" />
               </columns>
            </TableView>
            <TextField fx:id="txtMedicineID" layoutX="550.0" layoutY="130.0" promptText="Medicine ID" styleClass="text-field" />
            <Button layoutX="415.0" layoutY="239.0" mnemonicParsing="false" onAction="#btnAddInventoryOnAction" prefHeight="33.0" prefWidth="97.0" styleClass="form-button" text="ADD" />
            <Button layoutX="522.0" layoutY="239.0" mnemonicParsing="false" onAction="#btnUpdateInventoryOnAction" prefHeight="33.0" prefWidth="97.0" styleClass="form-button" text="UPDATE" />
            <Button layoutX="630.0" layoutY="239.0" mnemonicParsing="false" onAction="#btnDeleteInventoryOnAction" prefHeight="33.0" prefWidth="97.0" styleClass="form-button" text="DELETE" />
            <Button layoutX="738.0" layoutY="239.0" mnemonicParsing="false" onAction="#btnSearchInventoryOnAction" prefHeight="33.0" prefWidth="97.0" styleClass="form-button" text="SEARCH" />
            <TextField fx:id="txtIBatchNumber" layoutX="391.0" layoutY="162.0" promptText="Batch Number" styleClass="text-field" />
            <DatePicker fx:id="txtManufactureDateExp" layoutX="710.0" layoutY="163.0" prefHeight="25.0" prefWidth="150.0" promptText="Manufacture Date" styleClass="text-field" />
            <TextField fx:id="txtQtyOnStock" layoutX="390.0" layoutY="196.0" promptText="Quantity In Stock" styleClass="text-field" />
            <TextField fx:id="txtCostPrice" layoutX="550.0" layoutY="198.0" promptText="Cost Price" styleClass="text-field" />
         </children>
      </Pane>
   </children>
</AnchorPane>
